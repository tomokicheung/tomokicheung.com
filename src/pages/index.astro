---
import { getCollection } from "astro:content";
import Base from "../layouts/Base.astro";

const projects = (await getCollection("work")).sort(
  (a, b) => a.data.order - b.data.order,
);
---

<Base
  title="Tomoki Cheung"
  description="Developer in Honolulu. Web development, client work, and writing about what breaks."
>
  <p class="meta">Honolulu, Hawaiʻi</p>
  <h1>Tomoki Cheung</h1>

  <div class="intro prose">
    <p>
      I build websites for businesses without technical staff, and I am
      finishing a computer science degree at UH Mānoa. Most of what I know
      came from shipping things and then finding out what I had missed.
    </p>
  </div>

  <hr class="rule" />

  <h2 class="section-label meta">Selected work</h2>
  <ul class="work-list">
    {projects.map((project) => (
      <li>
        <a href={`/work/${project.id}/`}>
          <span class="work-title">{project.data.title}</span>
          <span class="meta">{project.data.role} &middot; {project.data.status}</span>
        </a>
      </li>
    ))}
  </ul>

  <style>
    h1 {
      font-size: var(--display-lg);
      color: var(--vermilion);
      margin: 0.2em 0 0.6em;
    }

    .intro { margin-bottom: 4rem; }

    .rule { margin-bottom: 2.5rem; }

    .section-label { display: block; margin-bottom: 1.5rem; }

    .work-list {
      list-style: none;
      margin: 0;
      padding: 0;
    }

    .work-list li + li { border-top: 1px solid var(--rule); }

    .work-list a {
      display: flex;
      flex-wrap: wrap;
      align-items: baseline;
      justify-content: space-between;
      gap: 0.5rem 2rem;
      padding: 1.4rem 0;
      text-decoration: none;
    }

    .work-title {
      font-family: var(--serif);
      font-size: var(--display-md);
      line-height: 1.1;
    }

    .work-list a:hover .work-title { color: var(--vermilion); }
  </style>
</Base>
