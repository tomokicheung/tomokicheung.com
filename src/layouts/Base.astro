---
import { Font } from "astro:assets";
import "../styles/tokens.css";
import "../styles/base.css";

interface Props {
  title: string;
  description?: string;
}

const { title, description } = Astro.props;
const pathname = Astro.url.pathname;

// Astro.site comes from the `site` option in astro.config.mjs.
// Open Graph requires absolute URLs, so this cannot be relative.
const canonical = new URL(pathname, Astro.site).href;
---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" type="image/png" sizes="32x32" href="/icon-32.png" />
    <link rel="apple-touch-icon" href="/icon-180.png" />
    <meta name="generator" content={Astro.generator} />
    <title>{title}</title>
    {description && <meta name="description" content={description} />}
    <link rel="canonical" href={canonical} />

    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="Tomoki Cheung" />
    <meta property="og:title" content={title} />
    {description && <meta property="og:description" content={description} />}
    <meta property="og:url" content={canonical} />

    <!-- Absolute URL required: scrapers do not resolve relative paths.
         Lives in public/ rather than src/assets/ because Astro
         content-hashes processed images, which would change the URL on
         every rebuild and break every cached preview. -->
    <meta property="og:image" content={new URL("/og-image.jpg", Astro.site).href} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content="The tomokicheung.com home page: Tomoki Cheung set in a large serif over a warm paper background." />
    <meta name="twitter:card" content="summary_large_image" />
    <Font cssVariable="--font-cormorant" preload={[{ style: "normal" }]} />
    <Font cssVariable="--font-space-grotesk" />
  </head>

  <body>
    <header class="site-head">
      <a href="/" class="wordmark">Tomoki Cheung</a>
      <nav aria-label="Primary">
        <a href="/work/" aria-current={pathname.startsWith("/work") ? "page" : undefined}>Work</a>
        <a href="/writing/" aria-current={pathname.startsWith("/writing") ? "page" : undefined}>Writing</a>
        <a href="/about/" aria-current={pathname.startsWith("/about") ? "page" : undefined}>About</a>
      </nav>
    </header>

    <main id="main">
      <slot />
    </main>

    <footer class="site-foot">
      <span class="meta">Honolulu, Hawaiʻi</span>
      <a class="meta" href="mailto:tom@ourcradle.com">tom@ourcradle.com</a>
    </footer>

    <style>
      .site-head,
      .site-foot {
        display: flex;
        justify-content: space-between;
        align-items: baseline;
        gap: 1.75rem;
        padding: 2rem clamp(1.5rem, 5vw, 5rem);
        max-width: 1200px;
        margin: 0 auto;
      }

      .site-head { border-bottom: 1px solid var(--rule); }

      .wordmark {
        font-family: var(--serif);
        font-size: 1.35rem;
        text-decoration: none;
      }

      nav {
        display: flex;
        gap: 1.5rem;
      }

      nav a {
        font-size: var(--kicker);
        letter-spacing: 0.18em;
        text-transform: uppercase;
        font-weight: 500;
        text-decoration: none;
        color: var(--text-muted);
      }

      nav a:hover,
      nav a[aria-current="page"] { color: var(--ink); }

      main {
        max-width: 1200px;
        margin: 0 auto;
        padding: clamp(3rem, 8vw, 7rem) clamp(1.5rem, 5vw, 5rem);
        min-height: 60vh;
      }

      .site-foot {
        border-top: 1px solid var(--rule);
        margin-top: 4rem;
      }

      .site-foot a { text-decoration: none; }
      .site-foot a:hover { color: var(--ink); }
    </style>
  </body>
</html>
